---
import { supabase } from '../lib/supabase';

const today = new Date().toISOString().split('T')[0];

const { data: shows } = await supabase
  .from('events')
  .select('id, title, artist, subtitle, date, time, price, booking_url')
  .gte('date', today)
  .order('date', { ascending: true })
  .limit(10);

function fmtDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-ZA', {
    day: 'numeric', month: 'short',
  });
}

function fmtTime(t: string | null | undefined) {
  if (!t) return '';
  const [h, m] = t.split(':').map(Number);
  const ampm = h >= 12 ? 'PM' : 'AM';
  const hour = h % 12 || 12;
  return `${hour}:${String(m).padStart(2, '0')} ${ampm}`;
}
---

<section id="shows" class="section-fullscreen shows-section">
  <div class="shows-container">
    <div class="shows-header">
      <span class="shows-label">Upcoming</span>
      <h2 class="shows-title heading-display">Shows</h2>
    </div>

    <div class="shows-list">
      {shows && shows.length > 0 ? shows.map((show) => (
        <a href={show.booking_url ?? '#'} class="show-item" target="_blank" rel="noopener noreferrer">
          <div class="show-left">
            <span class="show-date">{fmtDate(show.date)}</span>
            <div class="show-info">
              <span class="show-title">{show.artist ?? show.title}</span>
              <span class="show-sub">{show.subtitle ?? show.title}</span>
            </div>
          </div>
          <div class="show-right">
            <span class="show-time">{fmtTime(show.time)}</span>
            {show.price && <span class="show-price">{show.price}</span>}
            <span class="show-arrow">&#8599;</span>
          </div>
        </a>
      )) : (
        <p class="no-shows">No upcoming shows right now. Check back soon.</p>
      )}
    </div>
  </div>
</section>

<style>
  .shows-section {
    background: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .shows-container {
    width: 100%;
    max-width: 900px;
  }

  .shows-header {
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shows-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .shows-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-white);
  }

  .shows-list {
    display: flex;
    flex-direction: column;
  }

  .show-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    transition: all 0.2s var(--ease-out);
    text-decoration: none;
    color: inherit;
  }

  .show-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .show-item:hover {
    padding-left: 1rem;
  }

  .show-item:hover .show-title {
    color: var(--color-accent);
  }

  .show-item:hover .show-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .show-left {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .show-date {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    min-width: 60px;
  }

  .show-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .show-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-white);
    transition: color 0.2s;
  }

  .show-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .show-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .show-time {
    font-size: 0.85rem;
    color: var(--color-text-subtle);
  }

  .show-price {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .show-arrow {
    font-size: 1.2rem;
    color: var(--color-accent);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all 0.2s var(--ease-out);
  }

  .no-shows {
    padding: 2rem 0;
    color: var(--color-text-subtle);
    font-size: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .shows-section {
      padding: var(--space-lg) var(--space-md);
      min-height: auto;
    }

    .show-item {
      align-items: center;
      gap: 1rem;
      padding: 1.25rem 0;
    }

    .show-left {
      flex: 1;
      min-width: 0;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .show-info {
      min-width: 0;
    }

    .show-title,
    .show-sub {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .show-right {
      flex-shrink: 0;
      gap: 0.75rem;
    }

    .show-time {
      display: none;
    }

    .show-price {
      font-size: 0.85rem;
    }

    .show-arrow {
      opacity: 0.7;
      transform: none;
      font-size: 1rem;
    }

    .show-item:hover {
      padding-left: 0;
    }
  }

  @media (max-width: 380px) {
    .shows-section {
      padding: var(--space-lg) 1.25rem;
    }

    .show-title {
      font-size: 1rem;
    }
  }
</style>
