---
import { supabase } from '../lib/supabase';

// Fetch featured event + hero_label from Supabase
const [{ data: featured }, { data: labelRow }] = await Promise.all([
  supabase
    .from('events')
    .select('title, artist, subtitle, date, time, price, image_url, image_alt, booking_url')
    .eq('is_featured', true)
    .limit(1)
    .maybeSingle(),
  supabase
    .from('site_content')
    .select('value')
    .eq('key', 'hero_label')
    .maybeSingle(),
]);

// Fallback data if Supabase is not yet configured
const heroData = featured ?? {
  artist:      'The One Room',
  title:       'Live Music & Comedy',
  date:        null,
  time:        null,
  price:       null,
  image_url:   '/images/zoe-modiga.jpg',
  image_alt:   'The One Room',
  booking_url: '#shows',
};

const heroLabel  = labelRow?.value ?? 'Next up';

function fmtDate(d: string | null) {
  if (!d) return '';
  return new Date(d + 'T00:00:00').toLocaleDateString('en-ZA', {
    weekday: 'short', day: 'numeric', month: 'short',
  });
}
---

<section id="hero" class="section-fullscreen hero">
  <div class="hero-image">
    <img src={heroData.image_url ?? '/images/zoe-modiga.jpg'} alt={heroData.image_alt ?? heroData.artist ?? ''} />
  </div>

  <div class="hero-content">
    <div class="hero-meta">
      <span class="hero-label">{heroLabel}</span>
      {(heroData.date || heroData.time) && (
        <span class="hero-date">
          {fmtDate(heroData.date)}{heroData.date && heroData.time ? ' — ' : ''}{heroData.time ? `Doors ${heroData.time}` : ''}
        </span>
      )}
    </div>

    <h1 class="hero-artist heading-display">{heroData.artist ?? heroData.title}</h1>
    {(heroData as any).subtitle && <p class="hero-tagline">{(heroData as any).subtitle}</p>}

    <a href={heroData.booking_url ?? '#shows'} class="btn btn-primary">
      {heroData.price ? `Get Tickets — ${heroData.price}` : 'See Shows'}
    </a>
  </div>

  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-bg);
  }

  .hero-image {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: var(--space-md);
  }

  .hero-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-date {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .hero-artist {
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    font-weight: 400;
  }

  .hero .btn {
    align-self: flex-start;
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-lg);
    right: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-scroll span {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    writing-mode: vertical-rl;
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-text-subtle);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: 50vh auto;
    }

    .hero-image {
      height: auto;
    }

    .hero-content {
      padding: var(--space-md);
      padding-bottom: var(--space-lg);
      justify-content: flex-start;
    }

    .hero-artist {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .hero-tagline {
      font-size: 1.05rem;
    }

    .hero .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .hero-content {
      padding: 1.25rem;
    }

    .hero-artist {
      font-size: 2rem;
    }
  }
</style>
