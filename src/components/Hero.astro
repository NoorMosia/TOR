---
// Hero section - fullscreen, image-forward, minimal text
// Data will come from Supabase later (featured event)
const heroData = {
  artist: 'Zoë Modiga',
  tagline: 'Nomhanda Tour',
  date: 'Sat 15 Aug',
  doors: '7:30 PM',
  price: 'R350',
  image: '/images/zoe-modiga.jpg',
};
---

<section id="hero" class="section-fullscreen hero">
  <div class="hero-image">
    <img src={heroData.image} alt={heroData.artist} />
  </div>

  <div class="hero-content">
    <div class="hero-meta">
      <span class="hero-label">Next up</span>
      <span class="hero-date">{heroData.date} — Doors {heroData.doors}</span>
    </div>

    <h1 class="hero-artist heading-display">{heroData.artist}</h1>
    <p class="hero-tagline">{heroData.tagline}</p>

    <a href="#shows" class="btn btn-primary">Get Tickets — {heroData.price}</a>
  </div>

  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-bg);
  }

  .hero-image {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: var(--space-md);
  }

  .hero-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-date {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .hero-artist {
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    font-weight: 400;
  }

  .hero .btn {
    align-self: flex-start;
  }

  /* Scroll indicator — bottom right */
  .hero-scroll {
    position: absolute;
    bottom: var(--space-lg);
    right: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-scroll span {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    writing-mode: vertical-rl;
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-text-subtle);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-rows: 50vh auto;
    }

    .hero-image {
      height: auto;
    }

    .hero-content {
      padding: var(--space-md);
      padding-bottom: var(--space-lg);
      justify-content: flex-start;
    }

    .hero-artist {
      font-size: clamp(2.2rem, 10vw, 3.2rem);
    }

    .hero-tagline {
      font-size: 1.05rem;
    }

    .hero .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-scroll {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .hero-content {
      padding: 1.25rem;
    }

    .hero-artist {
      font-size: 2rem;
    }
  }
</style>
