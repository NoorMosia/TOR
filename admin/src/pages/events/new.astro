---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionClient } from '../../lib/auth';

let errors: Record<string, string> = {};
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries(
    [...form.entries()].map(([k, v]) => [k, v.toString().trim()])
  );

  // Validate required fields
  if (!values.title)  errors.title = 'Required';
  if (!values.date)   errors.date  = 'Required';
  if (!values.time)   errors.time  = 'Required';

  if (Object.keys(errors).length === 0) {
    const supabase = getSessionClient(Astro.cookies);

    // If setting as featured, unfeature all others first
    if (values.is_featured === 'on') {
      await supabase.from('events').update({ is_featured: false }).neq('id', '00000000-0000-0000-0000-000000000000');
    }

    const { data, error } = await supabase.from('events').insert({
      title:             values.title,
      artist:            values.artist     || null,
      subtitle:          values.subtitle   || null,
      description:       values.description || null,
      short_description: values.short_description || null,
      date:              values.date,
      time:              values.time,
      price:             values.price      || null,
      capacity:          values.capacity   || null,
      image_url:         values.image_url  || null,
      image_alt:         values.image_alt  || null,
      booking_url:       values.booking_url || null,
      is_featured:       values.is_featured === 'on',
    }).select('id').single();

    if (error) {
      errors._form = error.message;
    } else {
      return Astro.redirect(`/events/${data.id}?saved=1`);
    }
  }
}
---

<AdminLayout title="New Event" section="/events">

  <div class="action-bar">
    <a href="/events" class="btn btn-ghost btn-sm">← Back to events</a>
  </div>

  {errors._form && <p class="form-error-banner">{errors._form}</p>}

  <form method="POST" class="event-form">

    <div class="card">
      <p class="card-title">Show details</p>

      <div class="form-row">
        <div class="form-group">
          <label for="artist">Artist / Performer</label>
          <input type="text" id="artist" name="artist" value={values.artist ?? ''} placeholder="e.g. Zoë Modiga" />
        </div>
        <div class="form-group">
          <label for="title">Show title <span class="req">*</span></label>
          <input type="text" id="title" name="title" value={values.title ?? ''} placeholder="e.g. Nomhanda Tour" class={errors.title ? 'input-error' : ''} />
          {errors.title && <span class="field-error">{errors.title}</span>}
        </div>
      </div>

      <div class="form-group">
        <label for="subtitle">Subtitle</label>
        <input type="text" id="subtitle" name="subtitle" value={values.subtitle ?? ''} placeholder="Short supporting line" />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="date">Date <span class="req">*</span></label>
          <input type="date" id="date" name="date" value={values.date ?? ''} class={errors.date ? 'input-error' : ''} />
          {errors.date && <span class="field-error">{errors.date}</span>}
        </div>
        <div class="form-group">
          <label for="time">Doors / Start time <span class="req">*</span></label>
          <input type="time" id="time" name="time" value={values.time ?? ''} class={errors.time ? 'input-error' : ''} />
          {errors.time && <span class="field-error">{errors.time}</span>}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="price">Ticket price</label>
          <input type="text" id="price" name="price" value={values.price ?? ''} placeholder="e.g. R350" />
        </div>
        <div class="form-group">
          <label for="capacity">Capacity</label>
          <input type="text" id="capacity" name="capacity" value={values.capacity ?? ''} placeholder="e.g. 120 seats" />
        </div>
      </div>

      <div class="form-group">
        <label for="booking_url">Booking / ticket URL</label>
        <input type="url" id="booking_url" name="booking_url" value={values.booking_url ?? ''} placeholder="https://quicket.co.za/..." />
      </div>
    </div>

    <div class="card">
      <p class="card-title">Description</p>

      <div class="form-group">
        <label for="short_description">Short description</label>
        <input type="text" id="short_description" name="short_description" value={values.short_description ?? ''} placeholder="One line for listings" />
      </div>

      <div class="form-group">
        <label for="description">Full description</label>
        <textarea id="description" name="description" rows="5" placeholder="Shown on event detail page">{values.description ?? ''}</textarea>
      </div>
    </div>

    <div class="card">
      <p class="card-title">Image</p>

      <div class="form-group">
        <label for="image_url">Image URL</label>
        <input type="url" id="image_url" name="image_url" value={values.image_url ?? ''} placeholder="/images/artist.jpg or https://..." />
      </div>

      <div class="form-group">
        <label for="image_alt">Alt text</label>
        <input type="text" id="image_alt" name="image_alt" value={values.image_alt ?? ''} placeholder="Describe the image for screen readers" />
      </div>
    </div>

    <div class="card">
      <p class="card-title">Hero banner</p>
      <div class="checkbox-group">
        <input type="checkbox" id="is_featured" name="is_featured" checked={values.is_featured === 'on'} />
        <label for="is_featured">Feature this event on the homepage hero</label>
      </div>
      <p class="hint">Only one event can be featured at a time. Enabling this will unfeature the current one.</p>
    </div>

    <div class="form-actions">
      <a href="/events" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Create event</button>
    </div>

  </form>

</AdminLayout>

<style>
  .event-form { display: flex; flex-direction: column; gap: 1rem; }
  .req { color: var(--color-accent); }
  .input-error { border-color: var(--color-error) !important; }
  .field-error { font-size: 0.75rem; color: var(--color-error); }
  .form-error-banner {
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
    margin-bottom: 1rem;
  }
  .hint {
    font-size: 0.775rem;
    color: var(--color-text-subtle);
    margin-top: 0.5rem;
  }
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
</style>
