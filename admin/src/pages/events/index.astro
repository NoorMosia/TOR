---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionClient } from '../../lib/auth';

const supabase = getSessionClient(Astro.cookies);

const { data: events, error } = await supabase
  .from('events')
  .select('id, title, artist, date, time, price, is_featured')
  .order('date', { ascending: true });

function fmtDate(d: string) {
  return new Date(d + 'T00:00:00').toLocaleDateString('en-ZA', {
    weekday: 'short', day: 'numeric', month: 'short', year: 'numeric',
  });
}

const today = new Date().toISOString().split('T')[0];
---

<AdminLayout title="Events" section="/events">

  <div class="action-bar">
    <div class="action-bar-left">
      <span class="count-label">{events?.length ?? 0} events</span>
    </div>
    <a href="/events/new" class="btn btn-primary">+ Add event</a>
  </div>

  {error && <p class="error-msg">{error.message}</p>}

  {events && events.length > 0 ? (
    <div class="card" style="padding:0; overflow:hidden;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Artist</th>
            <th>Show</th>
            <th>Time</th>
            <th>Price</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {events.map((e) => (
            <tr class={e.date < today ? 'past-row' : ''}>
              <td style="white-space:nowrap">{fmtDate(e.date)}</td>
              <td class="td-primary">{e.artist ?? '—'}</td>
              <td>{e.title}</td>
              <td>{e.time}</td>
              <td>{e.price ?? '—'}</td>
              <td>
                {e.is_featured
                  ? <span class="badge badge-featured">Featured</span>
                  : e.date < today
                    ? <span class="badge badge-past">Past</span>
                    : <span class="badge badge-upcoming">Upcoming</span>
                }
              </td>
              <td class="td-actions">
                <a href={`/events/${e.id}`}>Edit</a>
                <button
                  class="delete-btn"
                  data-id={e.id}
                  data-name={e.artist ?? e.title}
                  aria-label="Delete"
                >Delete</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="empty-state">
      <p>No events yet.</p>
      <a href="/events/new" class="btn btn-primary">Add your first event</a>
    </div>
  )}

</AdminLayout>

<script>
  import { supabase } from '../../lib/supabase';

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id   = btn.dataset.id!;
      const name = btn.dataset.name!;
      if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;

      const { error } = await supabase.from('events').delete().eq('id', id);
      if (error) {
        alert('Delete failed: ' + error.message);
      } else {
        btn.closest('tr')?.remove();
        (window as any).showToast?.('Event deleted');
      }
    });
  });
</script>

<style>
  .count-label {
    font-size: 0.8rem;
    color: var(--color-text-subtle);
  }

  .error-msg {
    color: var(--color-error);
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  .past-row td {
    opacity: 0.45;
  }

  .badge-upcoming {
    background: rgba(212, 165, 116, 0.15);
    color: var(--color-warm);
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-past {
    background: var(--color-surface-high);
    color: var(--color-text-subtle);
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
