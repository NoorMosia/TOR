---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSessionClient } from '../../lib/auth';

const { id } = Astro.params;
const supabase = getSessionClient(Astro.cookies);

// Load existing event
const { data: event, error: loadError } = await supabase
  .from('events')
  .select('*')
  .eq('id', id)
  .single();

if (loadError || !event) {
  return Astro.redirect('/events');
}

let errors: Record<string, string> = {};
let saved = Astro.url.searchParams.get('saved') === '1';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const values: Record<string, string> = Object.fromEntries(
    [...form.entries()].map(([k, v]) => [k, v.toString().trim()])
  );

  const action = values._action;

  // --- Delete ---
  if (action === 'delete') {
    await supabase.from('events').delete().eq('id', id);
    return Astro.redirect('/events');
  }

  // --- Save ---
  if (!values.title) errors.title = 'Required';
  if (!values.date)  errors.date  = 'Required';
  if (!values.time)  errors.time  = 'Required';

  if (Object.keys(errors).length === 0) {
    const isFeatured = values.is_featured === 'on';

    // Unfeature others if setting featured
    if (isFeatured) {
      await supabase.from('events').update({ is_featured: false }).neq('id', id!);
    }

    const { error: saveError } = await supabase.from('events').update({
      title:             values.title,
      artist:            values.artist            || null,
      subtitle:          values.subtitle          || null,
      description:       values.description       || null,
      short_description: values.short_description || null,
      date:              values.date,
      time:              values.time,
      price:             values.price             || null,
      capacity:          values.capacity          || null,
      image_url:         values.image_url         || null,
      image_alt:         values.image_alt         || null,
      booking_url:       values.booking_url       || null,
      is_featured:       isFeatured,
    }).eq('id', id!);

    if (saveError) {
      errors._form = saveError.message;
    } else {
      return Astro.redirect(`/events/${id}?saved=1`);
    }
  }
}
---

<AdminLayout title="Edit Event" section="/events">

  <div class="action-bar">
    <a href="/events" class="btn btn-ghost btn-sm">← Back to events</a>
    {saved && <span class="saved-badge">✓ Saved</span>}
  </div>

  {errors._form && <p class="form-error-banner">{errors._form}</p>}

  <form method="POST" class="event-form">
    <input type="hidden" name="_action" value="save" />

    <div class="card">
      <p class="card-title">Show details</p>

      <div class="form-row">
        <div class="form-group">
          <label for="artist">Artist / Performer</label>
          <input type="text" id="artist" name="artist" value={event.artist ?? ''} placeholder="e.g. Zoë Modiga" />
        </div>
        <div class="form-group">
          <label for="title">Show title <span class="req">*</span></label>
          <input type="text" id="title" name="title" value={event.title ?? ''} class={errors.title ? 'input-error' : ''} />
          {errors.title && <span class="field-error">{errors.title}</span>}
        </div>
      </div>

      <div class="form-group">
        <label for="subtitle">Subtitle</label>
        <input type="text" id="subtitle" name="subtitle" value={event.subtitle ?? ''} />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="date">Date <span class="req">*</span></label>
          <input type="date" id="date" name="date" value={event.date ?? ''} class={errors.date ? 'input-error' : ''} />
          {errors.date && <span class="field-error">{errors.date}</span>}
        </div>
        <div class="form-group">
          <label for="time">Doors / Start time <span class="req">*</span></label>
          <input type="time" id="time" name="time" value={event.time ?? ''} class={errors.time ? 'input-error' : ''} />
          {errors.time && <span class="field-error">{errors.time}</span>}
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="price">Ticket price</label>
          <input type="text" id="price" name="price" value={event.price ?? ''} placeholder="e.g. R350" />
        </div>
        <div class="form-group">
          <label for="capacity">Capacity</label>
          <input type="text" id="capacity" name="capacity" value={event.capacity ?? ''} placeholder="e.g. 120 seats" />
        </div>
      </div>

      <div class="form-group">
        <label for="booking_url">Booking / ticket URL</label>
        <input type="url" id="booking_url" name="booking_url" value={event.booking_url ?? ''} placeholder="https://quicket.co.za/..." />
      </div>
    </div>

    <div class="card">
      <p class="card-title">Description</p>

      <div class="form-group">
        <label for="short_description">Short description</label>
        <input type="text" id="short_description" name="short_description" value={event.short_description ?? ''} placeholder="One line for listings" />
      </div>

      <div class="form-group">
        <label for="description">Full description</label>
        <textarea id="description" name="description" rows="5">{event.description ?? ''}</textarea>
      </div>
    </div>

    <div class="card">
      <p class="card-title">Image</p>

      <div class="form-row">
        <div class="form-group">
          <label for="image_url">Image URL</label>
          <input type="url" id="image_url" name="image_url" value={event.image_url ?? ''} placeholder="/images/artist.jpg or https://..." />
        </div>
        <div class="form-group">
          <label for="image_alt">Alt text</label>
          <input type="text" id="image_alt" name="image_alt" value={event.image_alt ?? ''} />
        </div>
      </div>

      {event.image_url && (
        <div class="image-preview">
          <img src={event.image_url} alt={event.image_alt ?? ''} />
        </div>
      )}
    </div>

    <div class="card">
      <p class="card-title">Hero banner</p>
      <div class="checkbox-group">
        <input type="checkbox" id="is_featured" name="is_featured" checked={event.is_featured} />
        <label for="is_featured">Feature this event on the homepage hero</label>
      </div>
      <p class="hint">Only one event can be featured at a time.</p>
    </div>

    <div class="form-actions">
      <button
        type="submit"
        form="delete-form"
        class="btn btn-danger"
        onclick="return confirm('Delete this event permanently?')"
      >Delete event</button>
      <div style="display:flex;gap:0.75rem;">
        <a href="/events" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </div>
  </form>

  <!-- Separate delete form to avoid accidental submissions -->
  <form id="delete-form" method="POST" style="display:none;">
    <input type="hidden" name="_action" value="delete" />
  </form>

</AdminLayout>

<style>
  .event-form { display: flex; flex-direction: column; gap: 1rem; }
  .req { color: var(--color-accent); }
  .input-error { border-color: var(--color-error) !important; }
  .field-error { font-size: 0.75rem; color: var(--color-error); }
  .form-error-banner {
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
    margin-bottom: 1rem;
  }
  .hint {
    font-size: 0.775rem;
    color: var(--color-text-subtle);
    margin-top: 0.5rem;
  }
  .saved-badge {
    font-size: 0.8rem;
    color: var(--color-success);
    font-weight: 600;
  }
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }
  .image-preview {
    margin-top: 1rem;
    max-width: 240px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .image-preview img {
    width: 100%;
    height: 160px;
    object-fit: cover;
  }
</style>
