---
const params = Astro.url.searchParams;
const step = params.get('step') === 'otp' ? 'otp' : 'email';
const email = params.get('email') ?? '';
const error = params.get('error') ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — TOR Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@400,500,600,700&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="login-shell">
      <div class="login-brand">
        <span class="login-logo">The One Room</span>
        <span class="login-label">Admin</span>
      </div>

      <div class="login-card">
        {step === 'email' ? (
          <>
            <h1 class="login-title">Sign in</h1>
            <p class="login-sub">Enter your email and we'll send you an 8-digit code.</p>

            {error && <p class="login-error">{error}</p>}

            <form method="POST" action="/api/send-otp" class="login-form">
              <div class="form-group">
                <label for="email">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value={email}
                  placeholder="you@theoneroom.co.za"
                  required
                  autofocus
                />
              </div>
              <button type="submit" class="btn btn-primary btn-full">
                Send code
              </button>
            </form>
          </>
        ) : (
          <>
            <h1 class="login-title">Enter code</h1>
            <p class="login-sub">
              We sent an 8-digit code to <strong>{email}</strong>. It expires in 10 minutes.
            </p>

            {error && <p class="login-error">{error}</p>}

            <form method="POST" action="/api/verify-otp" class="login-form">
              <input type="hidden" name="email" value={email} />
              <div class="form-group">
                <label for="token">Verification code</label>
                <input
                  type="text"
                  id="token"
                  name="token"
                  placeholder="12345678"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="8"
                  required
                  autofocus
                />
              </div>
              <button type="submit" class="btn btn-primary btn-full">
                Verify
              </button>
            </form>

            <p class="login-hint">
              Wrong email? <a href="/login">Start over</a>.
            </p>
          </>
        )}
      </div>
    </div>

    <style>
      *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

      :root {
        --color-bg:          #111110;
        --color-bg-alt:      #1a1918;
        --color-surface:     #242320;
        --color-white:       #f5f0eb;
        --color-text-muted:  #a8a29e;
        --color-text-subtle: #78716c;
        --color-accent:      #e54d2e;
        --color-border:      #2e2c2a;
        --color-error:       #f87171;
        --font-display:      'Clash Display', 'Inter', sans-serif;
        --font-body:         'Satoshi', 'Inter', sans-serif;
        --ease-out:          cubic-bezier(0.16, 1, 0.3, 1);
      }

      html, body {
        height: 100%;
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-white);
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--color-text-muted); }
      a:hover { color: var(--color-white); }

      .login-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        gap: 2rem;
      }

      .login-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
      }

      .login-logo {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-white);
      }

      .login-label {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-accent);
      }

      .login-card {
        width: 100%;
        max-width: 380px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 2rem;
      }

      .login-title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        color: var(--color-white);
        margin-bottom: 0.5rem;
      }

      .login-sub {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.6;
        margin-bottom: 1.75rem;
      }

      .login-sub strong {
        color: var(--color-white);
      }

      .login-error {
        font-size: 0.825rem;
        color: var(--color-error);
        background: rgba(248, 113, 113, 0.1);
        border: 1px solid rgba(248, 113, 113, 0.2);
        border-radius: 6px;
        padding: 0.6rem 0.9rem;
        margin-bottom: 1.25rem;
      }

      .login-form .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
      }

      label {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }

      input[type="email"],
      input[type="text"] {
        width: 100%;
        background: var(--color-bg-alt);
        border: 1px solid var(--color-border);
        border-radius: 6px;
        padding: 0.7rem 0.9rem;
        font-family: var(--font-body);
        font-size: 0.9rem;
        color: var(--color-white);
        outline: none;
        transition: border-color 0.15s;
      }

      input[type="text"] {
        font-size: 1.4rem;
        letter-spacing: 0.25em;
        text-align: center;
      }

      input:focus {
        border-color: #78716c;
      }

      input::placeholder {
        color: var(--color-text-subtle);
        letter-spacing: normal;
        font-size: 0.9rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.7rem 1.4rem;
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        border-radius: 6px;
        cursor: pointer;
        border: none;
        transition: background 0.2s;
      }

      .btn-primary { background: var(--color-accent); color: var(--color-white); }
      .btn-primary:hover { background: #c4391a; }
      .btn-full { width: 100%; }

      .login-hint {
        margin-top: 1rem;
        font-size: 0.8rem;
        color: var(--color-text-subtle);
        text-align: center;
      }
    </style>
  </body>
</html>
