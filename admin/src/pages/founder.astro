---
import AdminLayout from '../layouts/AdminLayout.astro';
import { getSessionClient } from '../lib/auth';

const supabase = getSessionClient(Astro.cookies);
let saved = false;
let saveError = '';

// Load all founder keys at once
const keys = ['founder_name', 'founder_role', 'founder_quote', 'founder_bio', 'founder_image'];
const { data: rows } = await supabase
  .from('site_content')
  .select('key, value')
  .in('key', keys);

const content: Record<string, string> = {};
rows?.forEach((r) => { content[r.key] = r.value; });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const updates = keys.map((key) => ({
    key,
    value: form.get(key)?.toString().trim() ?? content[key] ?? '',
  }));

  const { error } = await supabase
    .from('site_content')
    .upsert(updates, { onConflict: 'key' });

  if (error) {
    saveError = error.message;
  } else {
    // Refresh content after save
    updates.forEach(({ key, value }) => { content[key] = value; });
    saved = true;
  }
}
---

<AdminLayout title="About" section="/founder">

  <form method="POST" class="content-form">

    {saved && <p class="save-notice">✓ Changes saved</p>}
    {saveError && <p class="form-error-banner">{saveError}</p>}

    <div class="card">
      <p class="card-title">Founder</p>

      <div class="form-row">
        <div class="form-group">
          <label for="founder_name">Name</label>
          <input type="text" id="founder_name" name="founder_name" value={content.founder_name ?? ''} />
        </div>
        <div class="form-group">
          <label for="founder_role">Role / title</label>
          <input type="text" id="founder_role" name="founder_role" value={content.founder_role ?? ''} placeholder="e.g. Founder" />
        </div>
      </div>

      <div class="form-group">
        <label for="founder_image">Photo URL</label>
        <input type="text" id="founder_image" name="founder_image" value={content.founder_image ?? ''} placeholder="/images/noma.jpg" />
      </div>

      {content.founder_image && (
        <div class="image-preview">
          <img src={content.founder_image} alt={content.founder_name ?? 'Founder'} />
        </div>
      )}
    </div>

    <div class="card">
      <p class="card-title">Quote</p>
      <div class="form-group">
        <label for="founder_quote">Pull quote</label>
        <textarea id="founder_quote" name="founder_quote" rows="4">{content.founder_quote ?? ''}</textarea>
        <span class="field-hint">Displayed large on the about section. No quotes needed — they're added automatically.</span>
      </div>
    </div>

    <div class="card">
      <p class="card-title">Bio</p>
      <div class="form-group">
        <label for="founder_bio">Biography</label>
        <textarea id="founder_bio" name="founder_bio" rows="5">{content.founder_bio ?? ''}</textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save changes</button>
    </div>

  </form>

</AdminLayout>

<style>
  .content-form { display: flex; flex-direction: column; gap: 1rem; }
  .save-notice {
    font-size: 0.825rem;
    color: var(--color-success);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-error-banner {
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
    margin-bottom: 0.5rem;
  }
  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin-top: 0.3rem;
    display: block;
  }
  .image-preview {
    margin-top: 0.75rem;
    width: 120px;
    height: 160px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  .image-preview img { width: 100%; height: 100%; object-fit: cover; }
  .form-actions { display: flex; justify-content: flex-end; padding-top: 0.5rem; }
</style>
