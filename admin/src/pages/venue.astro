---
import AdminLayout from '../layouts/AdminLayout.astro';
import { getSessionClient } from '../lib/auth';

const supabase = getSessionClient(Astro.cookies);
let saved = false;
let saveError = '';

const keys = [
  'venue_address', 'venue_email', 'venue_phone', 'venue_hours',
  'footer_tagline', 'hero_label', 'site_title', 'site_description',
];

const { data: rows } = await supabase
  .from('site_content')
  .select('key, value')
  .in('key', keys);

const content: Record<string, string> = {};
rows?.forEach((r) => { content[r.key] = r.value; });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const updates = keys.map((key) => ({
    key,
    value: form.get(key)?.toString().trim() ?? content[key] ?? '',
  }));

  const { error } = await supabase
    .from('site_content')
    .upsert(updates, { onConflict: 'key' });

  if (error) {
    saveError = error.message;
  } else {
    updates.forEach(({ key, value }) => { content[key] = value; });
    saved = true;
  }
}
---

<AdminLayout title="Venue" section="/venue">

  <form method="POST" class="content-form">

    {saved && <p class="save-notice">✓ Changes saved</p>}
    {saveError && <p class="form-error-banner">{saveError}</p>}

    <div class="card">
      <p class="card-title">Contact &amp; location</p>

      <div class="form-group">
        <label for="venue_address">Address</label>
        <input type="text" id="venue_address" name="venue_address" value={content.venue_address ?? ''} placeholder="52 Westbourne Rd, Gqeberha" />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="venue_email">Email</label>
          <input type="email" id="venue_email" name="venue_email" value={content.venue_email ?? ''} placeholder="info@theoneroom.co.za" />
        </div>
        <div class="form-group">
          <label for="venue_phone">Phone</label>
          <input type="text" id="venue_phone" name="venue_phone" value={content.venue_phone ?? ''} placeholder="+27 (0) 21 555 0199" />
        </div>
      </div>

      <div class="form-group">
        <label for="venue_hours">Opening hours</label>
        <input type="text" id="venue_hours" name="venue_hours" value={content.venue_hours ?? ''} placeholder="Wed — Sun from 7 PM" />
      </div>
    </div>

    <div class="card">
      <p class="card-title">Footer</p>

      <div class="form-group">
        <label for="footer_tagline">Tagline</label>
        <input type="text" id="footer_tagline" name="footer_tagline" value={content.footer_tagline ?? ''} placeholder="Music. Comedy. Gqeberha." />
        <span class="field-hint">Short line shown under the logo in the footer.</span>
      </div>
    </div>

    <div class="card">
      <p class="card-title">Hero</p>

      <div class="form-group">
        <label for="hero_label">Hero eyebrow label</label>
        <input type="text" id="hero_label" name="hero_label" value={content.hero_label ?? ''} placeholder="Next up" />
        <span class="field-hint">Small label shown above the featured artist name on the homepage.</span>
      </div>
    </div>

    <div class="card">
      <p class="card-title">SEO</p>

      <div class="form-group">
        <label for="site_title">Page title</label>
        <input type="text" id="site_title" name="site_title" value={content.site_title ?? ''} />
        <span class="field-hint">Shown in browser tab and search results.</span>
      </div>

      <div class="form-group">
        <label for="site_description">Meta description</label>
        <textarea id="site_description" name="site_description" rows="3">{content.site_description ?? ''}</textarea>
        <span class="field-hint">Shown in search result snippets. Keep under 160 characters.</span>
      </div>

      <div class="char-count" id="descCount">
        <span id="descLen">{(content.site_description ?? '').length}</span> / 160
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save changes</button>
    </div>

  </form>

</AdminLayout>

<script>
  const textarea = document.getElementById('site_description') as HTMLTextAreaElement;
  const lenEl    = document.getElementById('descLen') as HTMLElement;
  textarea?.addEventListener('input', () => {
    const n = textarea.value.length;
    lenEl.textContent = String(n);
    lenEl.style.color = n > 160 ? 'var(--color-error)' : '';
  });
</script>

<style>
  .content-form { display: flex; flex-direction: column; gap: 1rem; }
  .save-notice {
    font-size: 0.825rem;
    color: var(--color-success);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .form-error-banner {
    background: rgba(248,113,113,0.1);
    border: 1px solid rgba(248,113,113,0.25);
    border-radius: 6px;
    padding: 0.7rem 1rem;
    font-size: 0.875rem;
    color: var(--color-error);
    margin-bottom: 0.5rem;
  }
  .field-hint {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin-top: 0.3rem;
    display: block;
  }
  .char-count {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
    margin-top: 0.3rem;
  }
  .form-actions { display: flex; justify-content: flex-end; padding-top: 0.5rem; }
</style>
